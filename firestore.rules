rules_version = '2';

/* ════════════════════════════════════════════════════════════════════
   Firestore security rules for Trending (project trending-app-db).

   These are the only thing standing between the database and anyone
   on the internet who reads the Firebase config out of index.html -
   which anyone can, because a web app's Firebase config is public by
   design. So everything is closed unless a rule below opens it, and
   each rule opens exactly what the app does today:

     users/{uid}     your profile and synced settings - only you
     sessions/{uid}  when you last signed out of every device - only you
     posts/{id}      the public feed - anyone reads; verified accounts
                     post as themselves, likes move by one

   Paste into Firebase console -> Firestore -> Rules -> Publish, or
   deploy with the Firebase CLI. Keep this file and the console in step.
   ════════════════════════════════════════════════════════════════════ */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function str(v, n) { return v is string && v.size() <= n; }

    /* Text other people will see, checked for shape as well as length.
       The app escapes everything it shows, and these keep out the
       characters that markup and attribute injection are made of, so a
       mistake in some renderer is not enough on its own. Regexes are RE2
       and written without backslashes, so nothing depends on how a rules
       string treats escapes. */
    function safeName(v) { return v is string && v.matches('^[^<>"`&]{1,80}$'); }
    function safeHandle(v) { return v is string && v.matches('^@[A-Za-z0-9._+-]{1,39}$'); }
    // Rules have no loops, so each of the (at most six) tags is checked
    // by position. && and || short-circuit, so a missing index is never read.
    function safeTag(s) { return s is string && s.matches('^#[^ <>"`&#]{1,40}$'); }
    function safeTags(t) {
      return t is list && t.size() <= 6
        && (t.size() < 1 || safeTag(t[0]))
        && (t.size() < 2 || safeTag(t[1]))
        && (t.size() < 3 || safeTag(t[2]))
        && (t.size() < 4 || safeTag(t[3]))
        && (t.size() < 5 || safeTag(t[4]))
        && (t.size() < 6 || safeTag(t[5]));
    }

    /* An email-and-password account has to confirm its address before
       it writes anything other people will see. Google and Apple
       accounts arrive confirmed; a phone account was confirmed by SMS. */
    function verified() {
      return request.auth.token.get('email_verified', false) == true
        || request.auth.token.firebase.sign_in_provider == 'phone';
    }

    /* "Sign out of every device" writes the time into sessions/{uid}.
       A session that signed in before then can no longer write, or read
       the profile. auth_time is when the session signed in, and it does
       not move when the token refreshes, so an old session stays old
       however long it keeps refreshing. */
    function sessionOk() {
      let p = /databases/$(database)/documents/sessions/$(request.auth.uid);
      return !exists(p)
        || request.auth.token.auth_time * 1000 > get(p).data.revokedAt.toMillis();
    }

    /* A person's own profile and settings. It holds their email
       address, so nobody else can read it - and nor can a session they
       have signed out everywhere. */
    match /users/{uid} {
      /* Counts and dates the account does not get to choose: they start
         where every account starts and the app never raises them itself,
         so a client that tries to is refused. Real follower counts and
         XP will be kept by a server; until then they stay put. */
      function fixed(field, start) {
        let d = request.resource.data;
        return !(field in d)
          || (resource == null ? d[field] == start
                               : (field in resource.data && d[field] == resource.data[field]));
      }
      allow read, delete: if isOwner(uid) && sessionOk();
      allow create, update: if isOwner(uid) && sessionOk()
        && request.resource.data.keys().hasOnly([
             'displayName', 'email', 'photoURL', 'xp', 'level',
             'joinedAt', 'followers', 'following', 'prefs', 'prefsAt'])
        && (!('displayName' in request.resource.data) || str(request.resource.data.displayName, 80))
        && fixed('xp', 0) && fixed('level', 1) && fixed('followers', 0) && fixed('following', 0)
        && fixed('joinedAt', request.time)
        // The address stored is the one the sign-in proved, not one typed in.
        && (!('email' in request.resource.data)
            || request.resource.data.email == request.auth.token.get('email', null));
    }

    /* When the account last signed out everywhere. Readable by the
       owner from ANY session, even an ended one - that is how an old
       device finds out it has been signed out, and it holds nothing but
       a time. Only a still-valid session can set it, and only to now. */
    match /sessions/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && sessionOk()
        && request.resource.data.keys().hasOnly(['revokedAt'])
        && request.resource.data.revokedAt == request.time;
      allow delete: if isOwner(uid) && sessionOk();
    }

    /* The public feed. */
    match /posts/{postId} {
      allow read: if true;

      // You can only post as yourself, with the counters at zero and the
      // server's clock on it - not a backdated or pre-liked post.
      //
      // The id must be one Firestore generated (addDoc: 20 letters and
      // digits). A client could otherwise pick its own with setDoc, and
      // an id is text that ends up inside the page.
      allow create: if signedIn() && verified() && sessionOk()
        && postId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly([
             'author', 'handle', 'uid', 'time', 'body', 'tags',
             'likes', 'comments', 'shares', 'type', 'category'])
        && request.resource.data.uid == request.auth.uid
        && safeName(request.resource.data.author)
        && safeHandle(request.resource.data.handle)
        // Anonymous posts stay on the device: every post carries its
        // account id, so a shared one would not be anonymous.
        && request.resource.data.handle != '@anonymous'
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000
        && safeTags(request.resource.data.tags)
        && request.resource.data.type is string
        && request.resource.data.type.matches('^[a-z]{1,16}$')
        && request.resource.data.category is string
        && request.resource.data.category.matches('^[a-z0-9_-]{1,30}$')
        && request.resource.data.likes == 0
        && request.resource.data.comments == 0
        && request.resource.data.shares == 0
        && request.resource.data.time == request.time;

      /* One like per person. A like is a document at likes/{uid}, written
         in the same batch as the count moves: the count may go up by one
         only as that person's like document appears, and down by one only
         as it disappears. It used to accept +1 from anyone, any number of
         times. */
      function likeDoc() { return /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid); }
      allow update: if signedIn() && verified() && sessionOk()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes >= 0
        && ((request.resource.data.likes == resource.data.likes + 1 && !exists(likeDoc()) && existsAfter(likeDoc()))
            || (request.resource.data.likes == resource.data.likes - 1 && exists(likeDoc()) && !existsAfter(likeDoc())));

      // Who liked a post is theirs to know, not everyone's.
      match /likes/{likerId} {
        function post() { return /databases/$(database)/documents/posts/$(postId); }
        allow read: if isOwner(likerId);
        allow create: if isOwner(likerId) && verified() && sessionOk()
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && getAfter(post()).data.likes == get(post()).data.likes + 1;
        allow delete: if isOwner(likerId) && sessionOk()
          && getAfter(post()).data.likes == get(post()).data.likes - 1;
      }

      // Only the author can delete their post - verified or not, so that
      // deleting an account always works.
      allow delete: if isOwner(resource.data.uid) && sessionOk();
    }
  }
}
