node_modules/
.env
.env.*
dist/
.DS_Store
*.log

# A snapshot of files another tool replaced. It is a backup, not source,
# and its copies of index.html and api.js still carry the old API keys —
# which is exactly what should not be added to history.
_removed/

# Anything holding a key for local development.
*.local.js
*.local.json

# A 1.3 MB single-file snapshot of the whole app - a second copy of
# every file, which would diverge the moment either side changed.
trending-standalone.html

# Rebuilt from CoinGecko by services/catalog.js; a cache, not source.
# Anchored to the root: a bare data/ also matched public/js/data/, where
# the translations and language list live, and refused to stage them.
/data/

# Trending Pay's local book (services/pay/store.js), used when no MONGO_URI
# is set: this machine's practice ledger and its signing keys, not source.
/.paydata/
